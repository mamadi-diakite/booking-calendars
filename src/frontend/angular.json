{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "booking-calendars-app": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/apps/booking-calendars-app",
      "sourceRoot": "projects/apps/booking-calendars-app/src",
      "prefix": "bc",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/apps/booking-calendars-app/src/main.ts",
            "tsConfig": "projects/apps/booking-calendars-app/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/apps/booking-calendars-app/public"
              }
            ],
            "styles": [
              "projects/apps/booking-calendars-app/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "booking-calendars-app:build:production"
            },
            "development": {
              "buildTarget": "booking-calendars-app:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "projects/apps/booking-calendars-app/proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "include": [
              "**/*.spec.ts",
              "../../../libs/**/*.spec.ts"
            ],
            "coverageInclude": [
              "projects/apps/booking-calendars-app/src/app/**/*.ts",
              "projects/libs/**/src/lib/**/*.ts"
            ],
            "coverageThresholds": {
              "statements": 100,
              "branches": 100,
              "functions": 100,
              "lines": 100
            }
          }
        }
      }
    }
  }
}
